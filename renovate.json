{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tx-pts-dai/renovate-config"
  ],
  "schedule": [
    "after 9am on Monday"
  ],
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Keep the old Terraform pin. The tf workflow tests rely on it.",
      "matchFileNames": [
        "tests/terraform/pinned/**"
      ],
      "enabled": false
    }
  ]
}
